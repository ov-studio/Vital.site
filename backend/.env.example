# Copy this file to .env.local and fill in real values.
# .env.local is already git-ignored, so it will never be committed.

# Upstash Redis (REST API) — Database → "REST API" tab on upstash.com
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Bearer secret for POST /masterlist/register
# Generate with: openssl rand -hex 32
MASTERLIST_ADMIN_SECRET=""

# Reject heartbeats whose claimed IP doesn't match the request IP.
# Set to false for local development; leave true (or unset) in production.
MASTERLIST_STRICT_IP=false

# ── Staff mint UI (GitHub OAuth) ─────────────────────────────────────────────
# Create an OAuth App: https://github.com/settings/developers
#   Authorization callback URL: https://api.<your-domain>/auth/github/callback
#   (local: http://localhost:3001/auth/github/callback)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Comma-separated GitHub usernames allowed to mint server tokens via /staff
# Example: STAFF_GITHUB_LOGINS=alice,bob
STAFF_GITHUB_LOGINS=""

# Optional separate HMAC secret for staff session tokens.
# If unset, MASTERLIST_ADMIN_SECRET is used.
# STAFF_JWT_SECRET=""
