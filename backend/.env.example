# Copy this file to .env.local and fill in real values.
# .env.local is already git-ignored, so it will never be committed.

# Upstash Redis (REST API) — Database → "REST API" tab on upstash.com
# Required for masterlist, rate limit, auth sessions, applications
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Reject heartbeats whose claimed IP doesn't match the request IP.
# Set to false for local development; leave true (or unset) in production.
MASTERLIST_STRICT_IP=false

# ── GitHub App ───────────────────────────────────────────
# Create under the org: https://github.com/organizations/ov-studio/settings/apps
# App name example: Vital.sandbox
#
# Permissions (repository): Contents, Pull requests, Workflows → Read & write
# Callback / Redirect URLs (Identifying and authorizing users):
#   https://api.vital-sandbox.com/auth/github/callback
#   http://localhost:3001/auth/github/callback
#
# Client ID  → App settings → About → Client ID (Iv23…)
# Client secret → Generate a new client secret (shown once)
GITHUB_APP_CLIENT_ID=""
GITHUB_APP_CLIENT_SECRET=""

# App ID → App settings → About → App ID (number)
# Installation ID → after Install App, from the URL:
#   https://github.com/organizations/ov-studio/settings/installations/<ID>
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=

# Private key → App settings → Private keys → Generate a private key (.pem)
# Paste the full PEM including BEGIN/END lines (multiline is fine).
GITHUB_APP_PRIVATE_KEY=""