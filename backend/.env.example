# Copy this file to .env.local and fill in real values.
# .env.local is already git-ignored, so it will never be committed.

# Upstash Redis (REST API) — Database → "REST API" tab on upstash.com
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Bearer secret for POST /api/masterlist/register
# Generate with: openssl rand -hex 32
MASTERLIST_ADMIN_SECRET=""

# Reject heartbeats whose claimed IP doesn't match the request IP.
# Set to false for local development; leave true (or unset) in production.
MASTERLIST_STRICT_IP=false

# Origin allowed to call these API routes via CORS (the static site's
# origin). Local dev: http://localhost:3000 (or whatever port `site` runs
# on). Production: your real site domain, e.g. https://vital-sandbox.com
SITE_ORIGIN="http://localhost:3000"
