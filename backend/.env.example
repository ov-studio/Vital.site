# Copy this file to .env.local and fill in real values.
# .env.local is already git-ignored, so it will never be committed.

# Upstash Redis (REST API) — required for masterlist, rate limit, auth sessions, applications
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Reject heartbeats whose claimed IP doesn't match the request IP.
# Set to false for local development; leave true (or unset) in production.
MASTERLIST_STRICT_IP=false

# ── GitHub OAuth (workspace login — all users) ───────────────────────────────
# OAuth App: https://github.com/settings/developers
# Callback: http://localhost:3001/auth/github/callback
#        or https://api.<domain>/auth/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Comma-separated GitHub usernames with staff powers in /workspace
# (approve/reject applications, direct mint). Everyone else can still log in and apply.
STAFF_GITHUB_LOGINS=""
