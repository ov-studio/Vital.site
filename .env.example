# Copy this file to .env.local and fill in real values.
# .env.local is already git-ignored, so it will never be committed.

# Optional for local dev — lib/api_url.ts already defaults to
# http://localhost:3001 if this isn't set, so you only need this file if
# you're running api-service on a different port, or want to test against
# a deployed api-service instance from your local site.
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Production (set as an environment variable in your hosting provider's
# project settings, not here — required there, since api_url.ts has no
# production fallback):
# NEXT_PUBLIC_API_URL="https://api.vital-sandbox.com"
